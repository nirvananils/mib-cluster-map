###########################################################################################
#
# Custom Green Engineering Menu screen: phone map on the digital cluster
# Attached to the top level of the green engineering menu, so it does not
# depend on any other screen being installed.
# Main -> ClusterMap
#
# The entries run scripts straight from the SD card in slot 1:
#   /fs/sda0/ClusterMap/GEM/
#
###########################################################################################
screen ClusterMap Main

keyValue
    value   String sys 0x00000000 0
    label   "Phone map on the digital cluster"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "SD card must be in slot 1. Reboot after install."
    poll    0

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/status.sh"
    label   "1. Status and compatibility check"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/install.sh"
    label   "2. Install cluster map"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/uninstall.sh"
    label   "Uninstall and restore original state"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/switch_to_turn_by_turn.sh"
    label   "Switch to turn-by-turn arrows instead (no map)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/savelogs.sh"
    label   "Save logs to SD"

keyValue
    value   String sys 0x00000000 0
    label   "Map settings. Each press saves; reboot to apply."
    poll    0

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/settings_show.sh"
    label   "Show current DPI and insets (file and running)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_dpi_up.sh"
    label   "DPI +5 (map larger)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_dpi_down.sh"
    label   "DPI -5 (map smaller)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_top_up.sh"
    label   "Inset top +5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_top_down.sh"
    label   "Inset top -5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_bottom_up.sh"
    label   "Inset bottom +5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_bottom_down.sh"
    label   "Inset bottom -5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_left_up.sh"
    label   "Inset left +5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_left_down.sh"
    label   "Inset left -5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_right_up.sh"
    label   "Inset right +5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_right_down.sh"
    label   "Inset right -5"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_preset_default.sh"
    label   "Preset: DPI 125, insets 40,40,127,127 (shipped)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/set_preset_seat.sh"
    label   "Preset: DPI 140, insets 105,127,127,127 (SEAT)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/collect_for_porting.sh"
    label   "Collect files for porting (quick)"

script
    value   sys 1 0x0100 "/fs/sda0/ClusterMap/GEM/collect_for_porting_full.sh"
    label   "Collect for porting, with Java image (55 MB, slow)"
